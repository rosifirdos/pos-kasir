// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id            Int       @id @default(autoincrement())
  categoryId    Int
  sku           String    @unique
  name          String
  imageUrl      String?
  buyPrice      Decimal   @db.Decimal(10, 2)
  sellPrice     Decimal   @db.Decimal(10, 2)
  currentStock  Int       @default(0)
  isRecipeBased Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category         Category            @relation(fields: [categoryId], references: [id])
  transactionItems TransactionDetail[]
  stockAdjustments StockAdjustment[]
  promoItems       PromoItem[]
  recipes          Recipe[]

  @@map("products")
}

model Transaction {
  id             Int      @id @default(autoincrement())
  invoiceNumber  String   @unique
  totalAmount    Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  paymentMethod  String   @default("CASH")
  status         String   @default("COMPLETED") // "COMPLETED" or "VOID"
  createdAt      DateTime @default(now())

  cashierId        Int?
  shiftId          Int?
  voidAuthorizedBy Int?
  promoId          Int?

  cashier        User?  @relation("CashierTransactions", fields: [cashierId], references: [id])
  shift          Shift? @relation(fields: [shiftId], references: [id])
  voidAuthorizer User?  @relation("VoidAuthorizedBy", fields: [voidAuthorizedBy], references: [id])
  promo          Promo? @relation(fields: [promoId], references: [id])

  details TransactionDetail[]

  @@map("transactions")
}

model TransactionDetail {
  id             Int     @id @default(autoincrement())
  transactionId  Int
  productId      Int
  quantity       Int
  unitPrice      Decimal @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)
  promoId        Int?

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  promo       Promo?      @relation(fields: [promoId], references: [id])

  @@map("transaction_details")
}

model StockAdjustment {
  id             Int      @id @default(autoincrement())
  productId      Int
  adjustmentType String // 'IN' or 'OUT'
  quantity       Int
  note           String?
  createdAt      DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@map("stock_adjustments")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  action     String // e.g., 'ADD_PRODUCT', 'UPDATE_PRODUCT', 'DELETE_PRODUCT', 'TRANSACTION', 'STOCK_IN', 'STOCK_OUT'
  entityType String // e.g., 'Product', 'Transaction', 'Stock'
  entityId   Int? // The ID of the affected entity
  details    String? // JSON string or plain text for more details
  createdAt  DateTime @default(now())

  @@map("activity_logs")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("KASIR") // "ADMIN" or "KASIR"
  pin          String? // Hashed PIN for Admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shifts           Shift[]
  transactions     Transaction[] @relation("CashierTransactions")
  voidTransactions Transaction[] @relation("VoidAuthorizedBy")

  @@map("users")
}

model Shift {
  id           Int       @id @default(autoincrement())
  userId       Int
  startTime    DateTime  @default(now())
  endTime      DateTime?
  startingCash Decimal   @db.Decimal(10, 2)
  expectedCash Decimal?  @db.Decimal(10, 2)
  actualCash   Decimal?  @db.Decimal(10, 2)
  status       String    @default("OPEN") // "OPEN" or "CLOSED"

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("shifts")
}

model Promo {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  type        String // 'PERCENTAGE', 'FIXED_AMOUNT', 'BOGO', 'HAPPY_HOUR'
  value       Decimal   @db.Decimal(10, 2)
  maxDiscount Decimal?  @db.Decimal(10, 2)
  minPurchase Decimal?  @db.Decimal(10, 2)
  startDate   DateTime?
  endDate     DateTime?
  startTime   String? // e.g. "14:00"
  endTime     String? // e.g. "17:00"
  quota       Int?
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  isStackable Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  promoItems         PromoItem[]
  transactions       Transaction[]
  transactionDetails TransactionDetail[]

  @@map("promos")
}

model PromoItem {
  id        Int @id @default(autoincrement())
  promoId   Int
  productId Int

  promo   Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("promo_items")
}

model Unit {
  id           Int    @id @default(autoincrement())
  name         String @unique
  abbreviation String

  rawMaterials RawMaterial[]

  @@map("units")
}

model RawMaterial {
  id            Int      @id @default(autoincrement())
  name          String
  unitId        Int
  stockQuantity Decimal  @db.Decimal(10, 3)
  minimumStock  Decimal  @db.Decimal(10, 3)
  costPerUnit   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unit    Unit     @relation(fields: [unitId], references: [id])
  recipes Recipe[]

  @@map("raw_materials")
}

model Recipe {
  id             Int     @id @default(autoincrement())
  productId      Int
  rawMaterialId  Int
  quantityNeeded Decimal @db.Decimal(10, 3)

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, rawMaterialId])
  @@map("recipes")
}
